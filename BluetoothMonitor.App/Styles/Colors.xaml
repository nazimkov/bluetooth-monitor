<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BluetoothMonitorAccent">#0078D4</Color>
            <Color x:Key="BluetoothMonitorAccentHover">#106EBE</Color>
            <Color x:Key="BluetoothMonitorAccentPressed">#005A9E</Color>
            <Color x:Key="BluetoothMonitorAccentSoft">#EFF6FC</Color>

            <Color x:Key="BluetoothMonitorOk">#107C10</Color>
            <Color x:Key="BluetoothMonitorWarn">#9D5D00</Color>
            <Color x:Key="BluetoothMonitorWarnBg">#FFF4CE</Color>
            <Color x:Key="BluetoothMonitorDanger">#C42B1C</Color>
            <Color x:Key="BluetoothMonitorDangerBg">#FDE7E9</Color>

            <Color x:Key="BluetoothMonitorWindowBackground">#F3F3F3</Color>
            <Color x:Key="BluetoothMonitorSurface">#FBFBFB</Color>
            <Color x:Key="BluetoothMonitorSurface2">#FFFFFF</Color>
            <Color x:Key="BluetoothMonitorDivider">#11000000</Color>
            <Color x:Key="BluetoothMonitorCardBorder">#12000000</Color>
            <Color x:Key="BluetoothMonitorCardBorderStrong">#1F000000</Color>
            <Color x:Key="BluetoothMonitorTextTertiary">#8A8A8A</Color>

            <SolidColorBrush
                x:Key="BluetoothMonitorAccentBrush"
                Color="{StaticResource BluetoothMonitorAccent}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorAccentHoverBrush"
                Color="{StaticResource BluetoothMonitorAccentHover}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorAccentSoftBrush"
                Color="{StaticResource BluetoothMonitorAccentSoft}"
            />
            <SolidColorBrush x:Key="BluetoothMonitorOkBrush" Color="{StaticResource BluetoothMonitorOk}" />
            <SolidColorBrush x:Key="BluetoothMonitorWarnBrush" Color="{StaticResource BluetoothMonitorWarn}" />
            <SolidColorBrush
                x:Key="BluetoothMonitorWarnBgBrush"
                Color="{StaticResource BluetoothMonitorWarnBg}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorDangerBrush"
                Color="{StaticResource BluetoothMonitorDanger}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorDangerBgBrush"
                Color="{StaticResource BluetoothMonitorDangerBg}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorWindowBackgroundBrush"
                Color="{StaticResource BluetoothMonitorWindowBackground}"
                Opacity="0"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorSurfaceBrush"
                Color="{StaticResource BluetoothMonitorSurface}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorSurface2Brush"
                Color="{StaticResource BluetoothMonitorSurface2}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorCardBorderBrush"
                Color="{StaticResource BluetoothMonitorCardBorder}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorCardBorderStrongBrush"
                Color="{StaticResource BluetoothMonitorCardBorderStrong}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorDividerBrush"
                Color="{StaticResource BluetoothMonitorDivider}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorTextTertiaryBrush"
                Color="{StaticResource BluetoothMonitorTextTertiary}"
            />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BluetoothMonitorAccent">#60CDFF</Color>
            <Color x:Key="BluetoothMonitorAccentHover">#4CC2FF</Color>
            <Color x:Key="BluetoothMonitorAccentPressed">#3AA8E0</Color>
            <Color x:Key="BluetoothMonitorAccentSoft">#1F60CDFF</Color>

            <Color x:Key="BluetoothMonitorOk">#6CCB5F</Color>
            <Color x:Key="BluetoothMonitorWarn">#FCE100</Color>
            <Color x:Key="BluetoothMonitorWarnBg">#1FFCE100</Color>
            <Color x:Key="BluetoothMonitorDanger">#FF99A4</Color>
            <Color x:Key="BluetoothMonitorDangerBg">#1FFF99A4</Color>

            <Color x:Key="BluetoothMonitorWindowBackground">#202020</Color>
            <Color x:Key="BluetoothMonitorSurface">#2B2B2B</Color>
            <Color x:Key="BluetoothMonitorSurface2">#323232</Color>
            <Color x:Key="BluetoothMonitorDivider">#12FFFFFF</Color>
            <Color x:Key="BluetoothMonitorCardBorder">#14FFFFFF</Color>
            <Color x:Key="BluetoothMonitorCardBorderStrong">#24FFFFFF</Color>
            <Color x:Key="BluetoothMonitorTextTertiary">#9B9B9B</Color>

            <SolidColorBrush
                x:Key="BluetoothMonitorAccentBrush"
                Color="{StaticResource BluetoothMonitorAccent}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorAccentHoverBrush"
                Color="{StaticResource BluetoothMonitorAccentHover}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorAccentSoftBrush"
                Color="{StaticResource BluetoothMonitorAccentSoft}"
            />
            <SolidColorBrush x:Key="BluetoothMonitorOkBrush" Color="{StaticResource BluetoothMonitorOk}" />
            <SolidColorBrush x:Key="BluetoothMonitorWarnBrush" Color="{StaticResource BluetoothMonitorWarn}" />
            <SolidColorBrush
                x:Key="BluetoothMonitorWarnBgBrush"
                Color="{StaticResource BluetoothMonitorWarnBg}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorDangerBrush"
                Color="{StaticResource BluetoothMonitorDanger}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorDangerBgBrush"
                Color="{StaticResource BluetoothMonitorDangerBg}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorWindowBackgroundBrush"
                Color="{StaticResource BluetoothMonitorWindowBackground}"
                Opacity="0"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorSurfaceBrush"
                Color="{StaticResource BluetoothMonitorSurface}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorSurface2Brush"
                Color="{StaticResource BluetoothMonitorSurface2}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorCardBorderBrush"
                Color="{StaticResource BluetoothMonitorCardBorder}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorCardBorderStrongBrush"
                Color="{StaticResource BluetoothMonitorCardBorderStrong}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorDividerBrush"
                Color="{StaticResource BluetoothMonitorDivider}"
            />
            <SolidColorBrush
                x:Key="BluetoothMonitorTextTertiaryBrush"
                Color="{StaticResource BluetoothMonitorTextTertiary}"
            />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
