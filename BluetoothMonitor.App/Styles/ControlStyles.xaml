<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BattcheckBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{ThemeResource BattcheckSurface2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource BattcheckCardBorderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BattcheckBadgeAccent" TargetType="Border" BasedOn="{StaticResource BattcheckBadge}">
        <Setter Property="Background" Value="{ThemeResource BattcheckAccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="BattcheckBadgeOk" TargetType="Border" BasedOn="{StaticResource BattcheckBadge}">
        <Setter Property="Background" Value="{ThemeResource BattcheckAccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="BattcheckCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource BattcheckCardBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource BattcheckSurfaceBrush}" />
    </Style>

    <Style x:Key="BattcheckRowIcon" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource BattcheckSurface2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource BattcheckCardBorderBrush}" />
    </Style>

</ResourceDictionary>
