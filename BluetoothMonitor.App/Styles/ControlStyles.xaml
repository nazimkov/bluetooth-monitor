<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Style x:Key="BluetoothMonitorBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{ThemeResource BluetoothMonitorSurface2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource BluetoothMonitorCardBorderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="BluetoothMonitorBadgeAccent"
        TargetType="Border"
        BasedOn="{StaticResource BluetoothMonitorBadge}"
    >
        <Setter Property="Background" Value="{ThemeResource BluetoothMonitorAccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="BluetoothMonitorBadgeOk" TargetType="Border" BasedOn="{StaticResource BluetoothMonitorBadge}">
        <Setter Property="Background" Value="{ThemeResource BluetoothMonitorAccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="BluetoothMonitorCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource BluetoothMonitorCardBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource BluetoothMonitorSurfaceBrush}" />
    </Style>

    <Style x:Key="BluetoothMonitorRowIcon" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource BluetoothMonitorSurface2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource BluetoothMonitorCardBorderBrush}" />
    </Style>
</ResourceDictionary>
