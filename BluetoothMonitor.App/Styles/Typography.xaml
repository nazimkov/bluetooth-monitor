<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <FontFamily x:Key="BluetoothMonitorFontFamily">Segoe UI Variable Text, Segoe UI, system-ui</FontFamily>
    <FontFamily x:Key="BluetoothMonitorMonoFamily">Cascadia Mono, Consolas, ui-monospace</FontFamily>

    <Style x:Key="BluetoothMonitorPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BluetoothMonitorFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="BluetoothMonitorPageSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BluetoothMonitorFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <Style x:Key="BluetoothMonitorSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BluetoothMonitorFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,8" />
    </Style>

    <Style x:Key="BluetoothMonitorRowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BluetoothMonitorFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BluetoothMonitorRowMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BluetoothMonitorFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="BluetoothMonitorMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BluetoothMonitorMonoFamily}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
</ResourceDictionary>
