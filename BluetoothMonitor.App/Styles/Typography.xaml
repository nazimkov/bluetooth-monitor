<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="BattcheckFontFamily">Segoe UI Variable Text, Segoe UI, system-ui</FontFamily>
    <FontFamily x:Key="BattcheckMonoFamily">Cascadia Mono, Consolas, ui-monospace</FontFamily>

    <Style x:Key="BattcheckPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BattcheckFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="BattcheckPageSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BattcheckFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <Style x:Key="BattcheckSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BattcheckFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,8" />
    </Style>

    <Style x:Key="BattcheckRowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BattcheckFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BattcheckRowMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BattcheckFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="BattcheckMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BattcheckMonoFamily}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

</ResourceDictionary>
