<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BluetoothMonitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BluetoothMonitor.App"
    xmlns:views="using:BluetoothMonitor.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
>
    <Grid x:Name="RootGrid" Background="{ThemeResource BluetoothMonitorWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="36"
            VerticalAlignment="Top"
            Background="Transparent"
        >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Glyph="&#xEBA9;"
                FontSize="14"
                Margin="12,0,8,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource BluetoothMonitorAccentBrush}"
            />
            <TextBlock
                Grid.Column="1"
                x:Uid="AppTitle"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
        </Grid>

        <NavigationView
            x:Name="RootNav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            AutomationProperties.AutomationId="RootNav"
            SelectionChanged="RootNav_SelectionChanged"
        >
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="NavSearch"
                    x:Uid="NavSearch"
                    IsEnabled="False"
                    QueryIcon="Find"
                    AutomationProperties.AutomationId="NavSearch"
                />
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavDevices"
                    x:Uid="NavDevices"
                    Tag="devices"
                    IsSelected="True"
                    AutomationProperties.AutomationId="NavDevices"
                >
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE702;"
                        />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavNotifications"
                    x:Uid="NavNotifications"
                    Tag="notifications"
                    AutomationProperties.AutomationId="NavNotifications"
                >
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xEA8F;"
                        />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavGeneral"
                    x:Uid="NavGeneral"
                    Tag="general"
                    AutomationProperties.AutomationId="NavGeneral"
                >
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE713;"
                        />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavAbout"
                    x:Uid="NavAbout"
                    Tag="about"
                    AutomationProperties.AutomationId="NavAbout"
                >
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE946;"
                        />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame
                x:Name="ContentFrame"
                IsNavigationStackEnabled="False"
                AutomationProperties.AutomationId="ContentFrame"
            />
        </NavigationView>
    </Grid>
</Window>
