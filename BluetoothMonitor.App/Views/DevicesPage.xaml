<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BluetoothMonitor.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BluetoothMonitor.App.Controls"
    xmlns:conv="using:BluetoothMonitor.App.Converters"
    xmlns:vm="using:BluetoothMonitor.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="DevicesPage"
>
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
    </Page.Resources>

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock
                Text="Devices"
                Style="{StaticResource BluetoothMonitorPageTitle}"
                AutomationProperties.AutomationId="DevicesPageTitle"
            />
            <TextBlock
                Text="Choose which Bluetooth audio device Bluetooth Monitor shows in your system tray."
                Style="{StaticResource BluetoothMonitorPageSub}"
            />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsBluetoothOff, Mode=OneWay}"
                Severity="Error"
                Title="Bluetooth is turned off on this PC"
                Message="Turn on Bluetooth in Windows Quick Settings to see paired devices."
                IsClosable="False"
                AutomationProperties.AutomationId="BluetoothOffInfoBar"
            >
                <InfoBar.ActionButton>
                    <Button
                        Content="Open Bluetooth settings"
                        Command="{x:Bind ViewModel.OpenBluetoothSettingsCommand}"
                        AutomationProperties.AutomationId="OpenBluetoothSettingsButton"
                    />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsCriticalBattery, Mode=OneWay}"
                Severity="Error"
                Title="Battery is critically low"
                Message="Charge soon to avoid disconnection."
                IsClosable="False"
                AutomationProperties.AutomationId="CriticalBatteryInfoBar"
            />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsLowBattery, Mode=OneWay}"
                Severity="Warning"
                Title="Low battery"
                Message="Your monitored device is under the low-battery threshold."
                IsClosable="False"
                AutomationProperties.AutomationId="LowBatteryInfoBar"
            />

            <TextBlock Text="Currently monitoring" Style="{StaticResource BluetoothMonitorSectionTitle}" />
            <controls:HeroCard
                Device="{x:Bind ViewModel.SelectedDevice, Mode=OneWay}"
                RefreshCommand="{x:Bind ViewModel.PollNowCommand}"
                AutomationProperties.AutomationId="HeroCard"
            />

            <Grid Margin="0,28,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                >
                    <TextBlock
                        Text="Paired devices"
                        Style="{StaticResource BluetoothMonitorSectionTitle}"
                        Margin="0"
                    />
                    <TextBlock
                        Text="{x:Bind ViewModel.Devices.Count, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        FontSize="12"
                        AutomationProperties.AutomationId="DeviceCount"
                    />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.AutomationId="RescanButton"
                    >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="&#xE72C;"
                                FontSize="14"
                            />
                            <TextBlock Text="Rescan" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.PairNewCommand}"
                        AutomationProperties.AutomationId="PairNewButton"
                    >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="&#xE710;"
                                FontSize="14"
                            />
                            <TextBlock Text="Pair new" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Style="{StaticResource BluetoothMonitorCard}"
                AutomationProperties.AutomationId="DeviceList"
            >
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                            <controls:DeviceRow Device="{x:Bind}" Tapped="DeviceRow_Tapped" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <StackPanel
                HorizontalAlignment="Center"
                Spacing="12"
                Margin="0,40,0,40"
                Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay, Converter={StaticResource BoolToVisConv}}"
                AutomationProperties.AutomationId="EmptyDevicesState"
            >
                <Border
                    Width="88"
                    Height="88"
                    CornerRadius="44"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource BluetoothMonitorCardBorderStrongBrush}"
                    Background="{ThemeResource BluetoothMonitorSurfaceBrush}"
                    HorizontalAlignment="Center"
                >
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Glyph="&#xE702;"
                        FontSize="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource BluetoothMonitorTextTertiaryBrush}"
                    />
                </Border>
                <TextBlock
                    Text="No paired devices yet"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                />
                <TextBlock
                    Text="Put your headphones or earbuds into pairing mode, then press Pair new to add them."
                    HorizontalAlignment="Center"
                    MaxWidth="340"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                />
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Pair new device"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.PairNewCommand}"
                    AutomationProperties.AutomationId="EmptyPairNewButton"
                />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
