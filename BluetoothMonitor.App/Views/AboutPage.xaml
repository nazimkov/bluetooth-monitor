<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BluetoothMonitor.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctkc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="AboutPage"
>
    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock
                x:Uid="AboutPageTitle"
                Style="{StaticResource BluetoothMonitorPageTitle}"
                AutomationProperties.AutomationId="AboutPageTitle"
            />
            <TextBlock
                x:Uid="AboutPageSubtitle"
                Style="{StaticResource BluetoothMonitorPageSub}"
            />

            <ctkc:SettingsCard
                x:Uid="AboutAppCard"
                Description="{x:Bind ViewModel.Platform, Mode=OneWay}"
            >
                <ctkc:SettingsCard.HeaderIcon>
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Glyph="&#xEBA9;"
                        Foreground="{ThemeResource BluetoothMonitorAccentBrush}"
                    />
                </ctkc:SettingsCard.HeaderIcon>
                <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}" FontWeight="SemiBold" />
            </ctkc:SettingsCard>

            <ctkc:SettingsCard
                x:Uid="PrivacyCard"
            >
                <ctkc:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                </ctkc:SettingsCard.HeaderIcon>
                <Button
                    x:Uid="PrivacyPolicyButton"
                    Command="{x:Bind ViewModel.OpenPrivacyPolicyCommand}"
                    AutomationProperties.AutomationId="PrivacyPolicyButton"
                />
            </ctkc:SettingsCard>

            <ctkc:SettingsCard
                x:Uid="CheckUpdatesCard"
            >
                <ctkc:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE721;" />
                </ctkc:SettingsCard.HeaderIcon>
                <Button
                    x:Uid="CheckNowButton"
                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                    AutomationProperties.AutomationId="CheckForUpdatesButton"
                />
            </ctkc:SettingsCard>

            <InfoBar
                x:Uid="UpdateInfoBar"
                IsOpen="{x:Bind ViewModel.UpdateInfoVisible, Mode=OneWay}"
                Severity="Informational"
                Message="{x:Bind ViewModel.UpdateInfoText, Mode=OneWay}"
                AutomationProperties.AutomationId="UpdateInfoBar"
            >
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="OpenReleaseButton"
                        Command="{x:Bind ViewModel.OpenUpdateCommand}"
                        AutomationProperties.AutomationId="OpenUpdateButton"
                    />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </ScrollViewer>
</Page>
