<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BluetoothMonitor.App.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctkc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="GeneralPage"
>
    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock
                x:Uid="GeneralPageTitle"
                Style="{StaticResource BluetoothMonitorPageTitle}"
                AutomationProperties.AutomationId="GeneralPageTitle"
            />
            <TextBlock
                x:Uid="GeneralPageSubtitle"
                Style="{StaticResource BluetoothMonitorPageSub}"
            />

            <TextBlock x:Uid="Startup" Style="{StaticResource BluetoothMonitorSectionTitle}" />

            <ctkc:SettingsCard
                x:Uid="StartAtSignInCard"
            >
                <ctkc:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                </ctkc:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}"
                    AutomationProperties.AutomationId="StartAtSignInToggle"
                />
            </ctkc:SettingsCard>

            <ctkc:SettingsCard
                x:Uid="KeepRunningCard"
            >
                <ctkc:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE968;" />
                </ctkc:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="{x:Bind ViewModel.KeepRunningInBackground, Mode=TwoWay}"
                    AutomationProperties.AutomationId="KeepRunningToggle"
                />
            </ctkc:SettingsCard>

            <TextBlock x:Uid="Polling" Style="{StaticResource BluetoothMonitorSectionTitle}" />

            <ctkc:SettingsCard
                x:Uid="RefreshIntervalCard"
            >
                <ctkc:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                </ctkc:SettingsCard.HeaderIcon>
                <ComboBox
                    SelectedIndex="{x:Bind ViewModel.RefreshIndex, Mode=TwoWay}"
                    MinWidth="180"
                    AutomationProperties.AutomationId="RefreshIntervalCombo"
                >
                    <ComboBoxItem x:Uid="Every15Seconds" />
                    <ComboBoxItem x:Uid="Every30Seconds" />
                    <ComboBoxItem x:Uid="EveryMinute" />
                    <ComboBoxItem x:Uid="Every5Minutes" />
                    <ComboBoxItem x:Uid="Every10Minutes" />
                </ComboBox>
            </ctkc:SettingsCard>

            <TextBlock x:Uid="Appearance" Style="{StaticResource BluetoothMonitorSectionTitle}" />

            <ctkc:SettingsCard x:Uid="ThemeCard">
                <ctkc:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                </ctkc:SettingsCard.HeaderIcon>
                <ComboBox
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                    MinWidth="140"
                    AutomationProperties.AutomationId="ThemeCombo"
                >
                    <ComboBoxItem x:Uid="SystemTheme" />
                    <ComboBoxItem x:Uid="LightTheme" />
                    <ComboBoxItem x:Uid="DarkTheme" />
                </ComboBox>
            </ctkc:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
