<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BluetoothMonitor.App.Controls.HeroCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BluetoothMonitor.App.Controls"
    xmlns:conv="using:BluetoothMonitor.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
>
    <UserControl.Resources>
        <conv:DeviceKindToLabelConverter x:Key="KindLabelConv" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConv" />
        <conv:NullableByteToByteConverter x:Key="ByteConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <Border Style="{StaticResource BluetoothMonitorCard}" Padding="20">
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:BatteryRing
                Grid.Column="0"
                PercentLevel="{x:Bind Device.BatteryLevel, Mode=OneWay, Converter={StaticResource ByteConv}}"
                Visibility="{x:Bind Device.BatteryLevel, Mode=OneWay, Converter={StaticResource NullToVisConv}}"
            />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Text="{x:Bind Device.Name, Mode=OneWay}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    AutomationProperties.AutomationId="HeroDeviceName"
                />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        Text="{x:Bind Device.Kind, Mode=OneWay, Converter={StaticResource KindLabelConv}}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    />
                    <Border
                        Style="{StaticResource BluetoothMonitorBadgeOk}"
                        Visibility="{x:Bind Device.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisConv}}"
                    >
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Fill="{ThemeResource BluetoothMonitorOkBrush}"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                x:Uid="HeroConnectedStatus"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource BluetoothMonitorOkBrush}"
                                AutomationProperties.AutomationId="HeroConnectedStatus"
                            />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        x:Uid="HeroDisconnectedStatus"
                        FontSize="11"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        AutomationProperties.AutomationId="HeroDisconnectedStatus"
                        Visibility="{x:Bind Device.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter=Invert}"
                    />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
            >
                <Button
                    x:Uid="HeroRefreshButton"
                    Command="{x:Bind RefreshCommand, Mode=OneWay}"
                    AutomationProperties.AutomationId="HeroRefreshButton"
                >
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Glyph="&#xE72C;"
                        FontSize="14"
                    />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
