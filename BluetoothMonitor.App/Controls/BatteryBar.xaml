<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BluetoothMonitor.App.Controls.BatteryBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:BluetoothMonitor.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BatteryLevelToBrushConverter x:Key="BatteryBrushConv" />
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Grid Width="140" Height="6">
            <Border Background="{ThemeResource BattcheckDividerBrush}" CornerRadius="3" />
            <Border x:Name="FillBorder"
                    HorizontalAlignment="Left"
                    Background="{x:Bind PercentLevel, Mode=OneWay, Converter={StaticResource BatteryBrushConv}}"
                    CornerRadius="3" />
        </Grid>
        <TextBlock Text="{x:Bind PercentText, Mode=OneWay}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   MinWidth="36"
                   TextAlignment="Right" />
    </StackPanel>
</UserControl>
