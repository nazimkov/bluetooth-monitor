<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BluetoothMonitor.App.Controls.BatteryRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:BluetoothMonitor.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="80"
    Height="80"
>
    <UserControl.Resources>
        <conv:BatteryLevelToBrushConverter x:Key="BatteryBrushConv" />
    </UserControl.Resources>

    <Grid>
        <Ellipse
            Width="{x:Bind Size, Mode=OneWay}"
            Height="{x:Bind Size, Mode=OneWay}"
            Stroke="{ThemeResource BluetoothMonitorCardBorderBrush}"
            StrokeThickness="{x:Bind StrokeThickness, Mode=OneWay}"
            Fill="Transparent"
        />
        <Path
            x:Name="ArcPath"
            Stroke="{x:Bind PercentLevel, Mode=OneWay, Converter={StaticResource BatteryBrushConv}}"
            StrokeThickness="{x:Bind StrokeThickness, Mode=OneWay}"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
        />
        <TextBlock
            x:Name="PercentTextBlock"
            Text="{x:Bind PercentText, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="20"
            FontWeight="SemiBold"
        />
    </Grid>
</UserControl>
