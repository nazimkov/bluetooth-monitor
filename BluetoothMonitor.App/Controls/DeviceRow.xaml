<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BluetoothMonitor.App.Controls.DeviceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BluetoothMonitor.App.Controls"
    xmlns:conv="using:BluetoothMonitor.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:DeviceKindToLabelConverter x:Key="KindLabelConv" />
        <conv:DeviceKindToGlyphConverter x:Key="KindGlyphConv" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:NullableByteToByteConverter x:Key="ByteConv" />
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Padding="14,12" BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource BattcheckDividerBrush}"
            Background="Transparent">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <RadioButton Grid.Column="0"
                         IsChecked="{x:Bind Device.IsMonitored, Mode=OneWay}"
                         GroupName="DeviceRowSelection"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />

            <Border Grid.Column="1" Style="{StaticResource BattcheckRowIcon}">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="{x:Bind Device.Kind, Mode=OneWay, Converter={StaticResource KindGlyphConv}}"
                          FontSize="18" />
            </Border>

            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="DeviceNameText"
                               Text="{x:Bind Device.Name, Mode=OneWay}"
                               Style="{StaticResource BattcheckRowTitle}" />
                    <Border Style="{StaticResource BattcheckBadgeAccent}"
                            Visibility="{x:Bind Device.IsMonitored, Mode=OneWay, Converter={StaticResource BoolToVisConv}}">
                        <TextBlock Text="Monitoring"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource BattcheckAccentBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Device.Kind, Mode=OneWay, Converter={StaticResource KindLabelConv}}"
                               Style="{StaticResource BattcheckRowMeta}" />
                    <TextBlock Text="&#x2022;" Style="{StaticResource BattcheckRowMeta}" />
                    <TextBlock Text="{x:Bind Device.MacAddress, Mode=OneWay}"
                               Style="{StaticResource BattcheckMono}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind Device.MacAddress, Mode=OneWay, Converter={StaticResource NullToVisConv}}" />
                </StackPanel>
            </StackPanel>

            <controls:BatteryBar Grid.Column="3"
                                 PercentLevel="{x:Bind Device.BatteryLevel, Mode=OneWay, Converter={StaticResource ByteConv}}"
                                 VerticalAlignment="Center"
                                 Visibility="{x:Bind Device.BatteryLevel, Mode=OneWay, Converter={StaticResource NullToVisConv}}" />
        </Grid>
    </Border>
</UserControl>
