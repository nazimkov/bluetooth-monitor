<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BluetoothMonitor.App.Controls.DeviceRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BluetoothMonitor.App.Controls"
    xmlns:conv="using:BluetoothMonitor.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
>
    <UserControl.Resources>
        <conv:DeviceKindToLabelConverter x:Key="KindLabelConv" />
        <conv:DeviceKindToGlyphConverter x:Key="KindGlyphConv" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv" />
        <conv:NullableByteToByteConverter x:Key="ByteConv" />
    </UserControl.Resources>

    <Border
        x:Name="RootBorder"
        Padding="14,12"
        BorderThickness="0,0,0,1"
        BorderBrush="{ThemeResource BluetoothMonitorDividerBrush}"
        Background="Transparent"
    >
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <RadioButton
                Grid.Column="0"
                Height="Auto"
                IsChecked="{x:Bind Device.IsMonitored, Mode=OneWay}"
                GroupName="DeviceRowSelection"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
            />

            <Border Grid.Column="1" Style="{StaticResource BluetoothMonitorRowIcon}">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Glyph="{x:Bind Device.Kind, Mode=OneWay, Converter={StaticResource KindGlyphConv}}"
                    FontSize="18"
                />
            </Border>

            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        x:Name="DeviceNameText"
                        Text="{x:Bind Device.Name, Mode=OneWay}"
                        Style="{StaticResource BluetoothMonitorRowTitle}"
                        TextTrimming="CharacterEllipsis"
                    />
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource BluetoothMonitorBadgeAccent}"
                        Visibility="{x:Bind Device.IsMonitored, Mode=OneWay, Converter={StaticResource BoolToVisConv}}"
                    >
                        <TextBlock
                            Text="Monitoring"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource BluetoothMonitorAccentBrush}"
                        />
                    </Border>
                </Grid>
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{x:Bind Device.Kind, Mode=OneWay, Converter={StaticResource KindLabelConv}}"
                        Style="{StaticResource BluetoothMonitorRowMeta}"
                    />
                    <TextBlock
                        x:Name="ConnectedDot"
                        Text="●"
                        FontSize="8"
                        Foreground="{ThemeResource BluetoothMonitorOkBrush}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Device.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisConv}}"
                    />
                    <TextBlock
                        x:Name="DisconnectedDot"
                        Text="●"
                        FontSize="8"
                        Foreground="{ThemeResource BluetoothMonitorTextTertiaryBrush}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Device.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisConv}, ConverterParameter=Invert}"
                    />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind Device.MacAddress, Mode=OneWay}"
                        Style="{StaticResource BluetoothMonitorMono}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind Device.MacAddress, Mode=OneWay, Converter={StaticResource NullToVisConv}}"
                    />
                </StackPanel>
            </StackPanel>

            <controls:BatteryBar
                x:Name="BatteryBarControl"
                Grid.Column="3"
                PercentLevel="{x:Bind Device.BatteryLevel, Mode=OneWay, Converter={StaticResource ByteConv}}"
                VerticalAlignment="Center"
                Visibility="{x:Bind Device.BatteryLevel, Mode=OneWay, Converter={StaticResource NullToVisConv}}"
            />
        </Grid>
    </Border>
</UserControl>
