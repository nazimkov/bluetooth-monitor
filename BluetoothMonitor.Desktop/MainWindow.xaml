<Window
    x:Class="BluetoothMonitor.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:BluetoothMonitor.Desktop"
    mc:Ignorable="d"
    Title="Bluetooth Monitor Desktop"
    >
    <!--Width="1200"-->
    <!--Height="720"-->

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="12">
            <TextBlock Text="Packaged RFCOMM diagnostics (requires sideloaded install for capabilities to apply)"
                       VerticalAlignment="Center"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,*" Padding="12" ColumnSpacing="16">
            <TextBlock Grid.ColumnSpan="2"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Text="Paired devices and RFCOMM services" />

            <Grid Grid.Row="1" ColumnDefinitions="*,*"
                  ColumnSpacing="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                        <TextBlock Text="Paired devices" FontWeight="SemiBold" />
                        <ProgressRing Width="20"
                                      Height="20"
                                      Margin="12,0,0,0"
                                      IsActive="{Binding IsBusy}" />
                    </StackPanel>

                    <ListView x:Name="DevicesList"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              Height="260">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DeviceEntry">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Id}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind KindDisplay}" FontSize="12" Opacity="0.8" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Content="Refresh devices"
                            Margin="0,12,0,0"
                            Width="160"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding CanRefresh}"
                            Click="RefreshDevices_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                        <TextBlock Text="RFCOMM services" FontWeight="SemiBold" />
                    </StackPanel>

                    <ListView x:Name="ServicesList"
                              ItemsSource="{Binding Services}"
                              SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                              Height="260">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ServiceEntry">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.8" />
                                    <TextBlock Text="{x:Bind AccessStatusText}" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                        <Button Content="Connect"
                                Width="120"
                                IsEnabled="{Binding IsConnectEnabled}"
                                Click="Connect_Click" />
                        <Button Content="Disconnect"
                                Width="120"
                                IsEnabled="{Binding IsConnected}"
                                Click="Disconnect_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="12"
                Padding="12"
                Background="#11111111"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Logs" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListView ItemsSource="{Binding Logs}" Height="150">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Window>
